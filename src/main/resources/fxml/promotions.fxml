<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="view-container"
            fx:controller="com.jenos.gestionecole.controller.PromotionsController">

    <!-- ─── TOP : En-tête ─── -->
    <top>
        <VBox styleClass="view-top-bar" spacing="6">
            <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
            <Label text="Gestion des Promotions &amp; Niveaux d'Étude" styleClass="view-title"/>
            <Label text="Niveau 2 de la structure académique : Section 1 ── N Promotions." styleClass="text-muted"/>
        </VBox>
    </top>

    <!-- ─── CENTER : Formulaire et Tableau ─── -->
    <center>
        <HBox spacing="18" styleClass="form-page-container">
            <padding><Insets top="16" right="20" bottom="20" left="20"/></padding>

            <!-- 1. Formulaire (gauche) -->
            <VBox fx:id="formSection" prefWidth="380" minWidth="320" styleClass="form-section-card" spacing="14">
                <Label fx:id="lblFormTitle" text="Nouvelle Promotion" styleClass="section-card-title"/>
                <Label fx:id="lblMessage" visible="false" managed="false"/>

                <VBox spacing="4">
                    <Label text="Section de rattachement *" styleClass="field-label"/>
                    <ComboBox fx:id="cmbSection" promptText="Choisir la section..." maxWidth="Infinity" styleClass="filter-combo"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Code de la promotion *" styleClass="field-label"/>
                    <TextField fx:id="txtCode" promptText="ex: 6SEC, 5SEC, 1SEC" styleClass="input-field"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Nom de la promotion *" styleClass="field-label"/>
                    <TextField fx:id="txtName" promptText="ex: 6e Secondaire, 5e Secondaire" styleClass="input-field"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Description" styleClass="field-label"/>
                    <TextArea fx:id="txtDescription" promptText="Description éventuelle..." prefRowCount="3" styleClass="input-field"/>
                </VBox>

                <CheckBox fx:id="chkActive" text="Promotion active pour les inscriptions" selected="true" styleClass="field-label"/>

                <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="btnReset" onAction="#handleReset" text="Effacer" styleClass="btn-secondary"/>
                    <Button fx:id="btnSave" onAction="#handleSave" text="Enregistrer la Promotion" styleClass="btn-primary"/>
                </HBox>
            </VBox>

            <!-- 2. Tableau des promotions (droite) -->
            <VBox HBox.hgrow="ALWAYS" styleClass="form-section-card" spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Promotions Configurées" styleClass="section-card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Filtrer par Section :" styleClass="field-label"/>
                    <ComboBox fx:id="cmbFilterSection" prefWidth="180" styleClass="filter-combo"/>
                </HBox>

                <TableView fx:id="tablePromotions" VBox.vgrow="ALWAYS" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="tcCode" text="Code" prefWidth="90"/>
                        <TableColumn fx:id="tcName" text="Nom de la Promotion" prefWidth="180"/>
                        <TableColumn fx:id="tcSection" text="Section" prefWidth="130"/>
                        <TableColumn fx:id="tcDescription" text="Description" prefWidth="200"/>
                        <TableColumn fx:id="tcStatus" text="Statut" prefWidth="90"/>
                        <TableColumn fx:id="tcActions" text="Actions" prefWidth="140" sortable="false"/>
                    </columns>
                </TableView>
            </VBox>

        </HBox>
    </center>

</BorderPane>
