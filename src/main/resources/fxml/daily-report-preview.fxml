<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="view-container"
            fx:controller="com.jenos.gestionecole.controller.DailyReportPreviewController">

    <!-- ─── TOP : Barre d'outils du visualiseur ─── -->
    <top>
        <VBox styleClass="view-top-bar" spacing="6">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button fx:id="btnClose" onAction="#handleClose" text="✕ Fermer" styleClass="btn-secondary"/>
                <Separator orientation="VERTICAL"/>

                <Label text="Aperçu avant impression — Rapport Journalier de Caisse" style="-fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnZoomOut" onAction="#handleZoomOut" text="🔍 -" styleClass="btn-secondary"/>
                <Label fx:id="lblZoom" text="100%" styleClass="field-label"/>
                <Button fx:id="btnZoomIn" onAction="#handleZoomIn" text="🔍 +" styleClass="btn-secondary"/>
                <Separator orientation="VERTICAL"/>

                <Button fx:id="btnExportPdf" onAction="#handleExportPdf" text="📄 Exporter PDF" styleClass="btn-secondary"/>
                <Button fx:id="btnPrint" onAction="#handlePrint" text="🖨 Imprimer le Rapport" styleClass="btn-primary"/>
            </HBox>
        </VBox>
    </top>

    <!-- ─── CENTER : Feuille A4 de simulation ─── -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="app-scroll" style="-fx-background-color: #525659;">
            <VBox alignment="CENTER" style="-fx-background-color: #525659; -fx-padding: 20;">
                <!-- Feuille A4 blanche -->
                <VBox fx:id="paperPage" prefWidth="650" minHeight="850"
                      style="-fx-background-color: white; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 3);"
                      spacing="16">

                    <!-- En-tête officiel établissement -->
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="COMPLEXE SCOLAIRE JENOS" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #0d6efd;"/>
                            <Label text="Enseignement Primaire, Secondaire et Technique" style="-fx-font-size: 11; -fx-text-fill: #6c757d;"/>
                            <Label text="Kinshasa, RDC • Direction Financière" style="-fx-font-size: 10; -fx-text-fill: #6c757d;"/>
                        </VBox>
                        <VBox alignment="TOP_RIGHT" spacing="2">
                            <Label fx:id="lblDocNumber" text="N° RAP-2026-0926-001" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                            <Label fx:id="lblDocDate" text="Date : 26/09/2026" style="-fx-text-fill: #6c757d; -fx-font-size: 11;"/>
                        </VBox>
                    </HBox>

                    <Separator/>

                    <VBox alignment="CENTER" spacing="4">
                        <Label text="PROCÈS-VERBAL &amp; RAPPORT JOURNALIER DE CAISSE" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-underline: true;"/>
                        <Label fx:id="lblCaisseDetails" text="Caisse 01 • Responsable : Marie • Statut : Ouverte à 07:42" style="-fx-text-fill: #495057; -fx-font-size: 11;"/>
                    </VBox>

                    <!-- Tableau récapitulatif 1 : Soldes et mouvements théoriques -->
                    <Label text="I. ÉTAT DES MOUVEMENTS &amp; SOLDES THÉORIQUES" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                    <GridPane gridLinesVisible="true" style="-fx-padding: 4;">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="40"/>
                            <ColumnConstraints percentWidth="30"/>
                            <ColumnConstraints percentWidth="30"/>
                        </columnConstraints>

                        <!-- En-tête -->
                        <Label text="Rubrique" style="-fx-font-weight: bold; -fx-padding: 4;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label text="Devise USD" style="-fx-font-weight: bold; -fx-padding: 4;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Devise CDF" style="-fx-font-weight: bold; -fx-padding: 4;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                        <!-- Lignes -->
                        <Label text="Solde initial à l'ouverture" style="-fx-padding: 4;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="lblRptInitUSD" text="50.00 USD" style="-fx-padding: 4;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label fx:id="lblRptInitCDF" text="100 000 CDF" style="-fx-padding: 4;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                        <Label text="+ Total Entrées (Encaissements)" style="-fx-padding: 4;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="lblRptInUSD" text="+ 150.00 USD" style="-fx-padding: 4;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label fx:id="lblRptInCDF" text="+ 85 000 CDF" style="-fx-padding: 4;" GridPane.columnIndex="2" GridPane.rowIndex="2"/>

                        <Label text="- Total Sorties (Dépenses)" style="-fx-padding: 4;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Label fx:id="lblRptOutUSD" text="- 65.00 USD" style="-fx-padding: 4;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label fx:id="lblRptOutCDF" text="- 0 CDF" style="-fx-padding: 4;" GridPane.columnIndex="2" GridPane.rowIndex="3"/>

                        <Label text="= SOLDE THÉORIQUE ATTENDU" style="-fx-font-weight: bold; -fx-padding: 4;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <Label fx:id="lblRptTheoUSD" text="135.00 USD" style="-fx-font-weight: bold; -fx-padding: 4;" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        <Label fx:id="lblRptTheoCDF" text="185 000 CDF" style="-fx-font-weight: bold; -fx-padding: 4;" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                    </GridPane>

                    <!-- Section II : Répartition des encaissements -->
                    <Label text="II. SYNTHÈSE DES ENCAISSEMENTS &amp; QUITTANCES" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                    <VBox spacing="4" style="-fx-border-color: #dee2e6; -fx-padding: 8; -fx-background-color: #f8f9fa;">
                        <Label text="• Frais scolaires et inscriptions perçus sous quittance officielle." style="-fx-font-size: 11;"/>
                        <Label text="• Règle absolue de non-commingling : les fonds CDF et USD ont été encaissés dans leurs caissons respectifs." style="-fx-font-size: 11;"/>
                    </VBox>

                    <!-- Signatures -->
                    <Region VBox.vgrow="ALWAYS"/>
                    <HBox spacing="40" alignment="BOTTOM_CENTER">
                        <VBox alignment="CENTER" spacing="30" HBox.hgrow="ALWAYS">
                            <Label text="La Caissière" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                            <Label text="(Signature &amp; Date)" style="-fx-font-size: 10; -fx-text-fill: #6c757d;"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="30" HBox.hgrow="ALWAYS">
                            <Label text="Le Contrôleur / Superviseur" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                            <Label text="(Signature &amp; Sceau)" style="-fx-font-size: 10; -fx-text-fill: #6c757d;"/>
                        </VBox>
                    </HBox>

                    <Label text="Document officiel généré par le Système de Gestion Intégrée Jenos."
                           style="-fx-font-size: 9; -fx-text-fill: #adb5bd;" alignment="CENTER" maxWidth="Infinity"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
