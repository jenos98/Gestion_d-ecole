<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="view-container"
            fx:controller="com.jenos.gestionecole.controller.SettingsController">

    <!-- ─── TOP : En-tête ─── -->
    <top>
        <VBox styleClass="view-top-bar" spacing="6">
            <Label text="Paramètres &amp; Configuration du Système" styleClass="view-title"/>
            <Label text="Gestion institutionnelle, années scolaires, devises et sécurité des comptes." styleClass="text-muted"/>
            <Label fx:id="lblSettingsStatus" visible="false" managed="false"/>
        </VBox>
    </top>

    <!-- ─── CENTER : Onglets de Paramétrage ─── -->
    <center>
        <TabPane fx:id="tabPaneSettings" tabClosingPolicy="UNAVAILABLE" styleClass="main-tab-pane">

            <!-- 1. Établissement -->
            <Tab fx:id="tabSchool" text="Établissement">
                <ScrollPane fitToWidth="true" styleClass="app-scroll">
                    <VBox spacing="16" styleClass="form-page-container">
                        <VBox styleClass="form-section-card" spacing="14">
                            <Label text="Identité de l'École" styleClass="section-card-title"/>
                            <GridPane hgap="16" vgap="14">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="50"/>
                                </columnConstraints>

                                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Nom officiel de l'école *" styleClass="field-label"/>
                                    <TextField fx:id="txtSchoolName" text="Complexe Scolaire Jenos" styleClass="input-field"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Adresse physique *" styleClass="field-label"/>
                                    <TextField fx:id="txtSchoolAddress" text="Avenue de l'Enseignement N° 12" styleClass="input-field"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="Téléphone officiel" styleClass="field-label"/>
                                    <TextField fx:id="txtSchoolPhone" text="+243 81 000 0000" styleClass="input-field"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="Email de contact" styleClass="field-label"/>
                                    <TextField fx:id="txtSchoolEmail" text="contact@ecolejenos.cd" styleClass="input-field"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="Devise Principale *" styleClass="field-label"/>
                                    <ComboBox fx:id="cmbPrimaryCurrency" maxWidth="Infinity" styleClass="filter-combo"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label text="Devise Secondaire *" styleClass="field-label"/>
                                    <ComboBox fx:id="cmbSecondaryCurrency" maxWidth="Infinity" styleClass="filter-combo"/>
                                </VBox>
                            </GridPane>

                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <Button fx:id="btnSaveSchoolInfo" onAction="#handleSaveSchool" text="Enregistrer les Modifications" styleClass="btn-primary"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- 2. Options d'Étude -->
            <Tab fx:id="tabOptions" text="Options d'Étude">
                <ScrollPane fitToWidth="true" styleClass="app-scroll">
                    <VBox spacing="16" styleClass="form-page-container">
                        <VBox styleClass="form-section-card" spacing="14">
                            <Label text="Gestion des Options &amp; Filières" styleClass="section-card-title"/>
                            <Label text="Configurez les filières académiques (Scientifique, Commerciale, Littéraire, etc.) rattachées aux promotions." styleClass="text-muted"/>
                            <Button text="Ouvrir la Console de Gestion des Options" onAction="#handleManageOptions" styleClass="btn-primary"/>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- 3. Apparence -->
            <Tab fx:id="tabAppearance" text="Apparence">
                <ScrollPane fitToWidth="true" styleClass="app-scroll">
                    <VBox spacing="16" styleClass="form-page-container">
                        <VBox styleClass="form-section-card" spacing="14">
                            <Label text="Thème et Affichage" styleClass="section-card-title"/>
                            <VBox spacing="10">
                                <RadioButton fx:id="rbThemeLight" text="Thème Clair (Par défaut pour bureau scolaire)" selected="true"/>
                                <RadioButton fx:id="rbThemeDark" text="Thème Sombre"/>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- 4. Compte & Sécurité -->
            <Tab fx:id="tabAccount" text="Mon Compte">
                <ScrollPane fitToWidth="true" styleClass="app-scroll">
                    <VBox spacing="16" styleClass="form-page-container">
                        <VBox styleClass="form-section-card" spacing="14">
                            <Label text="Sécurité &amp; Mot de Passe" styleClass="section-card-title"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Rôle connecté :" styleClass="field-label"/>
                                <Label fx:id="lblCurrentRole" text="PROMOTEUR" styleClass="badge, badge-success"/>
                            </HBox>

                            <VBox spacing="6">
                                <Label text="Ancien mot de passe *" styleClass="field-label"/>
                                <PasswordField fx:id="txtOldPassword" styleClass="input-field"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Nouveau mot de passe *" styleClass="field-label"/>
                                <PasswordField fx:id="txtNewPassword" styleClass="input-field"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Confirmer le nouveau mot de passe *" styleClass="field-label"/>
                                <PasswordField fx:id="txtConfirmPassword" styleClass="input-field"/>
                            </VBox>

                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <Button fx:id="btnChangePassword" onAction="#handleChangePassword" text="Modifier le Mot de Passe" styleClass="btn-primary"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
