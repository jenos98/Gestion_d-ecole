<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="view-container"
            fx:controller="com.jenos.gestionecole.controller.ClassesController">

    <!-- ─── TOP : En-tête ─── -->
    <top>
        <VBox styleClass="view-top-bar" spacing="6">
            <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
            <Label text="Gestion des Classes &amp; Salles de Cours" styleClass="view-title"/>
            <Label text="Niveau 4 de la hiérarchie scolaire : Section › Promotion › Option › Classe." styleClass="text-muted"/>
        </VBox>
    </top>

    <!-- ─── CENTER : Formulaire et Tableau ─── -->
    <center>
        <HBox spacing="18" styleClass="form-page-container">
            <padding><Insets top="16" right="20" bottom="20" left="20"/></padding>

            <!-- 1. Formulaire d'ajout / modification (gauche) -->
            <VBox fx:id="formSection" prefWidth="400" minWidth="340" styleClass="form-section-card" spacing="12">
                <Label fx:id="lblFormTitle" text="Nouvelle Classe" styleClass="section-card-title"/>
                <Label fx:id="lblMessage" visible="false" managed="false"/>

                <!-- Cascade Hiérarchique Dépendante -->
                <VBox spacing="4">
                    <Label text="1. Section *" styleClass="field-label"/>
                    <ComboBox fx:id="cmbSection" promptText="Choisir la section..." maxWidth="Infinity" styleClass="filter-combo"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="2. Promotion *" styleClass="field-label"/>
                    <ComboBox fx:id="cmbPromotion" promptText="Choisir la promotion..." maxWidth="Infinity" styleClass="filter-combo"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="3. Option d'étude (si applicable)" styleClass="field-label"/>
                    <ComboBox fx:id="cmbOption" promptText="Sans option ou choisir..." maxWidth="Infinity" styleClass="filter-combo"/>
                </VBox>

                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Nom de la classe *" styleClass="field-label"/>
                        <TextField fx:id="txtName" promptText="ex: 6e Scientifique A" styleClass="input-field"/>
                    </VBox>
                    <VBox spacing="4" prefWidth="120">
                        <Label text="Code *" styleClass="field-label"/>
                        <TextField fx:id="txtCode" promptText="ex: 6SC-A" styleClass="input-field"/>
                    </VBox>
                </HBox>

                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Professeur Titulaire" styleClass="field-label"/>
                        <TextField fx:id="txtTitulaire" promptText="ex: Prof. KABEYA" styleClass="input-field"/>
                    </VBox>
                    <VBox spacing="4" prefWidth="100">
                        <Label text="Capacité" styleClass="field-label"/>
                        <TextField fx:id="txtCapacity" promptText="45" styleClass="input-field"/>
                    </VBox>
                </HBox>

                <CheckBox fx:id="chkActive" text="Classe active pour les inscriptions" selected="true" styleClass="field-label"/>

                <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="btnReset" onAction="#handleReset" text="Effacer" styleClass="btn-secondary"/>
                    <Button fx:id="btnSave" onAction="#handleSave" text="Enregistrer la Classe" styleClass="btn-primary"/>
                </HBox>
            </VBox>

            <!-- 2. Tableau des classes avec filtres (droite) -->
            <VBox HBox.hgrow="ALWAYS" styleClass="form-section-card" spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Classes Configurées" styleClass="section-card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Filtre :" styleClass="field-label"/>
                    <ComboBox fx:id="cmbFilterSection" promptText="Section..." prefWidth="140" styleClass="filter-combo"/>
                    <ComboBox fx:id="cmbFilterOption" promptText="Option..." prefWidth="160" styleClass="filter-combo"/>
                </HBox>

                <TableView fx:id="tableClasses" VBox.vgrow="ALWAYS" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="tcCode" text="Code" prefWidth="85"/>
                        <TableColumn fx:id="tcName" text="Nom de Classe" prefWidth="170"/>
                        <TableColumn fx:id="tcPromotion" text="Promotion" prefWidth="110"/>
                        <TableColumn fx:id="tcOption" text="Option" prefWidth="140"/>
                        <TableColumn fx:id="tcTitulaire" text="Titulaire" prefWidth="140"/>
                        <TableColumn fx:id="tcCapacity" text="Capacité" prefWidth="75"/>
                        <TableColumn fx:id="tcStatus" text="Statut" prefWidth="85"/>
                        <TableColumn fx:id="tcActions" text="Actions" prefWidth="120" sortable="false"/>
                    </columns>
                </TableView>
            </VBox>

        </HBox>
    </center>

</BorderPane>
