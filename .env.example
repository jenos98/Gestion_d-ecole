# Configuration de l'environnement pour l'application Gestion Scolaire
# Renseigner ces variables avant de déployer l'application en production

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_scolaire
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_securise

# Configuration Applicative
APP_ENV=production
APP_DEFAULT_CURRENCY=USD
APP_THEME_DEFAULT=LIGHT
APP_BACKUP_DIR=backups/
